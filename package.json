{
  "name": "api-starter-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A batteries-included AdonisJS starter kit for building modern APIs with type-safe frontend integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OSpoon/api-starter-kit.git"
  },
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "docker:up": "node scripts/docker-up.mjs",
    "dev": "turbo dev bot:wecom bot:feishu bot:dingtalk",
    "build": "turbo build",
    "release": "bumpp",
    "version": "changelogen --output CHANGELOG.md",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.5.0",
    "bumpp": "^10.4.1",
    "changelogen": "^0.6.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.16"
  },
  "packageManager": "pnpm@11.9.0",
  "simple-git-hooks": {
    "pre-commit": "CI=true pnpm lint-staged"
  }
}