  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "application-postgres" },
      "description": "Counts persisted conversation records by creation day.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), COUNT(created_at) AS conversations FROM ai_chat_conversations WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "New conversations per day",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "application-postgres" },
      "description": "Counts persisted user-role messages; assistant messages are excluded.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), COUNT(created_at) AS user_messages FROM ai_chat_messages WHERE role = 'user' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "User messages per day",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "application-postgres" },
      "description": "Counts persisted model calls, including calls recorded with failed status.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), COUNT(created_at) AS model_calls FROM ai_usage_events WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Model calls per day",
      "type": "timeseries"
    }
