{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Assistant",
  "version": "0.0.0",
  "identifier": "com.osp.assistant-desktop",
  "build": {
    "devUrl": "http://localhost:17070",
    "beforeBuildCommand": "pnpm --dir ../assistant-web build",
    "frontendDist": "../../assistant-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Assistant",
        "width": 960,
        "height": 640,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}