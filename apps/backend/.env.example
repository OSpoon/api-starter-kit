# Node
TZ=Asia/Shanghai
PORT=13333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:13333

# Admin
# The first administrator is created automatically from these values.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=Change-Me-1234-5678-9012
ADMIN_FULL_NAME=Admin

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_DATABASE=app_db

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:18080,http://localhost:3000

#--------------------------------------------------------------------
# AI chat (OpenAI SDK compatible; DeepSeek by default)
#--------------------------------------------------------------------
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.deepseek.com
AI_OPENAI_MODEL=deepseek-v4-pro
