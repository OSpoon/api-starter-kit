# Node
TZ=Asia/Shanghai
PORT=13333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:13333

# Admin
# The first administrator is created automatically from these values.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=Change-Me-1234-5678-9012
ADMIN_FULL_NAME=Admin

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# OpenAPI docs (Scalar UI)
# When enabled, docs are served at http://<HOST>:<PORT>/api-docs
# Disabled by default in production; enable locally as needed.
#--------------------------------------------------------------------
OPENAPI_DOCS_ENABLED=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_DATABASE=app_db

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:18080,http://localhost:3000

#--------------------------------------------------------------------
# GitHub OAuth (create a GitHub OAuth App and register the callback below)
# Callback URL: http://localhost:13333/api/v1/auth/github/callback
# The frontend URL must point to its /login route.
#--------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_FRONTEND_URL=http://localhost:18080/login

#--------------------------------------------------------------------
# Cloudflare Turnstile (optional; required for password login when enabled)
# Create a widget at https://dash.cloudflare.com/turnstile
#--------------------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

#--------------------------------------------------------------------
# AI agent (OpenAI-compatible models)
# Defaults to local Ollama. Use any OpenAI-compatible provider: DeepSeek, Qwen, OpenAI, etc.
# Recommended: Use Ollama locally. Set env vars in your environment or .env file.
#   AI_OPENAI_API_KEY=ollama
#   AI_OPENAI_BASE_URL=http://localhost:11434/v1
#   AI_OPENAI_MODEL=llama3.2:1b
# Pull models manually: ollama pull llama3.2:1b
#--------------------------------------------------------------------
AI_OPENAI_API_KEY=ollama
AI_OPENAI_BASE_URL=http://localhost:11434/v1
AI_OPENAI_MODEL=llama3.2:1b
# Knowledge-base retrieval uses Qwen3-Embedding-0.6B (1024 dimensions) through an OpenAI-compatible endpoint.
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=Qwen3-Embedding-0.6B-4bit-DWQ
AI_EMBEDDING_DIMENSIONS=1024
# Semantic chunking options. These use the embedding model above to find
# sentence-level topic changes before applying the final length limit.
KNOWLEDGE_CHUNK_MAX_CHARACTERS=1800
KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=200
KNOWLEDGE_SEMANTIC_BREAKPOINT_PERCENTILE=90
AI_SYSTEM_PROMPT=
# Qwen tool calling uses a lower built-in temperature; other models use the
# service default. These runtime tuning values are intentionally not exposed.
AI_CONTEXT_COMPRESSION_ENABLED=true
# Context compression trigger in input tokens before summarization runs
# (default 6000) and how many recent messages to keep (default 8).
AI_CONTEXT_COMPRESSION_THRESHOLD_TOKENS=6000
AI_CONTEXT_COMPRESSION_RECENT_MESSAGES=8
# AI agent wall-clock timeout in milliseconds (5s–300s, default 180000).
# This budget covers multi-step tool calls as well as model generation.
AI_REQUEST_TIMEOUT_MS=180000

# Langfuse Cloud observability. Create a project in Langfuse Cloud and set the
# public/secret keys. Keep disabled until both keys are configured.
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Dedicated WeCom webhook for template tests. Never use a user template webhook for tests.
WECOM_TEST_WEBHOOK_URL=
