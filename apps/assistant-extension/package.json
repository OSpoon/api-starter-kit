{
  "name": "@api-starter-kit/assistant-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome side-panel client for the API Starter Kit AI assistant",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "extension dev --browser=chrome",
    "start": "extension start --browser=chrome",
    "build": "pnpm typecheck && extension build --browser=chrome",
    "preview": "extension preview --browser=chrome",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write --config ../../prettier.config.cjs --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --config ../../prettier.config.cjs --ignore-path ../../.prettierignore ."
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "markstream-vue": "^1.0.5",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.0",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.13.2",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-tailwindcss": "^4.0.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "~10.9.2",
    "extension": "^4.1.25",
    "jiti": "^2.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vue-tsc": "^3.3.5"
  },
  "license": "MIT"
}
