# Leave empty to use the same-origin API through the Vite/Nginx proxy.
VITE_API_URL=
# Absolute public frontend URL used by Open Graph metadata at build time; keep the trailing slash.
VITE_PUBLIC_URL=http://localhost:18080/
# Optional Cloudflare Turnstile site key. Enable together with backend TURNSTILE_* settings.
VITE_TURNSTILE_SITE_KEY=
# OpenAPI docs URL (served directly by the backend). Leave empty to hide the docs link.
VITE_API_DOCS_URL=
# Optional frontend branding overrides; empty values use the built-in defaults.
VITE_PLATFORM_NAME=
VITE_PLATFORM_TAGLINE=
