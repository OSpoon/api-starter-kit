VITE_API_URL=http://localhost:13333
# Optional Grafana URL. The development default is http://localhost:3000.
VITE_GRAFANA_URL=http://localhost:3000
# Match the Compose project name used by the application containers.
VITE_MONITORING_PROJECT=api-starter-kit
# Optional Cloudflare Turnstile site key. Enable together with backend TURNSTILE_* settings.
VITE_TURNSTILE_SITE_KEY=
# OpenAPI docs URL (served directly by the backend). Leave empty to hide the docs link.
VITE_API_DOCS_URL=http://localhost:13333/api-docs
